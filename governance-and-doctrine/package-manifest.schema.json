{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.example.invalid/schemas/project-package-manifest/0.1.0",
  "title": "KIS Project Engineering Package Manifest",
  "description": "Draft v0.1 format contract. Replace provisional $id with a managed published schema URI before production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "package_id",
    "package_revision",
    "status",
    "created_utc",
    "framework",
    "domain_schemas",
    "milestones",
    "files"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "package_revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "working",
        "review",
        "issued",
        "superseded"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "framework": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "commit"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "release_tag": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "domain_schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_id",
          "version"
        ],
        "properties": {
          "schema_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone_id",
          "status",
          "accepted_baseline_id",
          "exceptions"
        ],
        "properties": {
          "milestone_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "provisional",
              "accepted",
              "accepted_with_exceptions",
              "reopened"
            ]
          },
          "accepted_baseline_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "canonical",
              "working",
              "accepted_baseline",
              "source",
              "artifact",
              "receipt",
              "validation",
              "documentation"
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "report_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
