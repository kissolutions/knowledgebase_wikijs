    {
      "id": "IECC21-LIGHT-REDUCTION",
      "edition": "2021",
      "section": "C405.2.3 and C405.2.3.1",
      "verification": "primary_text_reviewed",
      "applies": {
        "space_types": [
          "other"
        ],
        "requires_no_compliant_occupancy_control": true,
        "special_application": false
      },
      "requirements": [
        {
          "key": "light_reduction_method",
          "op": "one_of",
          "value": [
            "continuous",
            "stepped",
            "alternate_luminaire_switching",
            "other_approved"
          ]
        }
      ],
      "source_urls": [
        "https://codes.iccsafe.org/content/IECC2021V3.0/chapter-4-ce-commercial-energy-efficiency"
      ],
      "notes": "Condition is broad (spaces without qualifying occupant controls); listed exceptions include daylight-responsive controls, specific application, single luminaire <60W, LPD <0.45W/ft² and corridors/lobbies/mechanical/electrical rooms. 'other' classification must not be treated as universal."
    },
